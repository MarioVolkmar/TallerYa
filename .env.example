# Variables de entorno de TallerYa (copia a .env o configúralas en Render). Nunca subas valores reales.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=tallerya.co,www.tallerya.co
DJANGO_CSRF_TRUSTED_ORIGINS=https://tallerya.co,https://www.tallerya.co
DATABASE_URL=postgres://usuario:clave@host:5432/tallerya

# Administrador inicial (lo crea build.sh la primera vez)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Correo para recuperar contraseñas (SMTP). Sin EMAIL_HOST los correos se imprimen en la consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TallerYa <no-responder@tallerya.co>

# TallerYa Plus
TALLERYA_WHATSAPP=573000000000
PLUS_NEQUI=300 000 0000
PLUS_PRECIO_MENSUAL=9900

# Fotos de talleres: ruta de un disco persistente (en Render, montar un Disk aquí)
DJANGO_MEDIA_ROOT=
