# Copia este archivo como .env (no se sube al repositorio) y llena los valores.

# --- Ingreso con Google (console.cloud.google.com > APIs y servicios > Credenciales > ID de cliente OAuth "Aplicación web") ---
# URI de redirección autorizada: http://localhost:8001/cuenta/google/volver/  (y la de producción: https://TU-DOMINIO/cuenta/google/volver/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Correo (SMTP). Sin EMAIL_HOST los correos salen por la consola del servidor ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=TallerYa <no-responder@tu-dominio.com>
SITIO_URL=http://localhost:8001

# Caché compartida entre procesos (opcional). Sin ella se usa memoria local de cada proceso.
# REDIS_URL=redis://localhost:6379/0

# Token de /tareas/avisos/ y /tareas/citas/ (los llama GitHub Actions a diario). Mínimo 20 caracteres; vacío = desactivado.
TAREAS_TOKEN=

# --- Desarrollo local: en tu .env pon DJANGO_DEBUG=1 (sin eso el sitio arranca en modo producción) ---
# DJANGO_DEBUG=1
# PROXIES_DE_CONFIANZA=1   # saltos de proxy delante de la app (IP real). Render: 1 (render.yaml ya lo pone); local: 0

# --- Producción (en Render se ponen en el panel; en local no hace falta tocarlas) ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=            # Render la genera sola (render.yaml)
# DJANGO_ALLOWED_HOSTS=tallerya.co,www.tallerya.co     # el *.onrender.com se agrega solo
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tallerya.co,https://www.tallerya.co
# DJANGO_HSTS_SECONDS=3600       # subir a 31536000 cuando el dominio propio esté estable
# DATABASE_URL=postgres://...    # Render la llena desde la base del Blueprint
# Archivos subidos: en Render el disco se borra en cada despliegue; apuntar a un disco persistente
# DJANGO_MEDIA_ROOT=/var/data/media
# DJANGO_PRIVADO_ROOT=/var/data/privado
# CARGAR_DEMO=0                  # 1 solo para una demo: carga talleres, foro y la cuenta demo

# --- Plus y contacto ---
# TALLERYA_WHATSAPP=573000000000
# PLUS_NEQUI=300 000 0000
# PLUS_PRECIO_MENSUAL=9900
# CONTACTO_WHATSAPP=
# CONTACTO_CORREO=
# CONTACTO_DIRECCION=
# CONTACTO_HORARIO=
# CONTACTO_INSTAGRAM=
# LEGAL_RAZON_SOCIAL=TallerYa
# LEGAL_NIT=
# LEGAL_CORREO=

# --- WhatsApp Cloud API de Meta ("consola" = solo escribe en el log) ---
# WHATSAPP_BACKEND=consola
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_PLANTILLA_PICO_PLACA=recordatorio_pico_placa
# WHATSAPP_PLANTILLA_REPROGRAMAR=cita_reprogramada
# WHATSAPP_PLANTILLA_CANCELAR=cita_cancelada

# --- Otros ---
# NOTICIAS_AUTO=1                # refresca titulares en segundo plano
# DESPIECE_CACHE_DIR=            # carpeta de la caché de dibujos SVG (por defecto, la temporal)
# DJANGO_LOG_LEVEL=INFO

# --- Avisos push al celular (Web Push). Sin claves el sitio funciona igual, solo sin push ---
# Generarlas: venv/Scripts/python.exe manage.py generar_vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
