{
  "name": "tallerya",
  "private": true,
  "description": "Solo para compilar el CSS de Tailwind (el sitio es Django).",
  "scripts": {
    "css": "tailwindcss -c tailwind/tailwind.config.js -i tailwind/entrada.css -o talleres/static/talleres/css/tw.css --minify",
